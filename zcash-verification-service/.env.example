### Zcash Verification Service (ZVS) - Example Environment

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_service_key

# Zcash RPC (zcashd)
ZCASH_RPC_URL=http://127.0.0.1:8232/
ZCASH_RPC_USER=rpc_username
ZCASH_RPC_PASS=rpc_password

# Admin inbox address (for incoming memos + OTP sends)
ADMIN_ADDRESS_INBOX=your_admin_inbox_address
# ZCASH_ADMIN_INBOX can be used instead of ADMIN_ADDRESS_INBOX
# ZCASH_ADMIN_INBOX=your_admin_inbox_address

# OTP behavior
OTP_AUTO_SEND=true
OTP_AMOUNT_ZEC=0.0005
OTP_HITL=true

# Devtool mode (optional, only if using zcash-devtool send path)
DEVTOOL_PATH=C:\path\to\zcash-devtool
WALLET_DIR=C:\path\to\wallet_dir
ADMIN_ACCOUNT_ID=your_admin_account_id
ADMIN_IDENTITY=C:\path\to\admin.agekey

# RPC scan behavior (optional)
POLL_REQUESTS_TABLE=verification_poll_requests
# RPC_DUMP_TXID=
# RPC_DUMP_ALL=false
